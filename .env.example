POSTGRES_DB=feekeeper
DB_PORT=5432
APP_PORT=8080
APP_CONTAINER_PORT=8080
PORT=8080
SPRING_PROFILES_ACTIVE=dev
JWT_SECRET=replace-with-at-least-32-random-bytes
